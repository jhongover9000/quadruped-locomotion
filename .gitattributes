# Auto detect text files and perform LF normalization
* text=auto

# Files that run on Linux (training machines, the robot's computer) keep LF
*.py   text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.xml  text eol=lf
*.urdf text eol=lf
*.ipynb text eol=lf

# Windows-only scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# --------------------------------------------------------------
# Git LFS -- run `git lfs install` once per machine.
# Large binaries that SHOULD be versioned: meshes and released policies.
# --------------------------------------------------------------
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.step filter=lfs diff=lfs merge=lfs -text
*.STEP filter=lfs diff=lfs merge=lfs -text
policies/released/**/*.onnx filter=lfs diff=lfs merge=lfs -text
policies/released/**/*.pt   filter=lfs diff=lfs merge=lfs -text

# Other binaries: never diff or merge as text
*.png binary
*.jpg binary
*.pdf binary
*.npz binary
*.npy binary
